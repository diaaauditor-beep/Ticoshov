# ---------------------------------------------------------------
# TICOSHOV environment variables
# Copy to .env.local and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
# Never commit real secrets.
# ---------------------------------------------------------------

# Public (safe to expose to the browser — protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Public site URL — used in auth email links (verification, password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NOT used by the running web app. Only needed by
# scripts/make-admin.mjs (bootstrap the first administrator) and the
# end-to-end test suite. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
